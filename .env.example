# Omnifood Server Environment Example
# Copy this file to .env and fill in real values before running the server.

# MongoDB connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/omnifood?retryWrites=true&w=majority

# JWT secret used for auth token signing
JWT_SECRET=replace_this_with_a_strong_random_secret

# Email account credentials for sending OTP emails
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-email-password-or-app-specific-password

# Optional port override
PORT=9000

# Google OAuth Client ID for frontend login/signup
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id

# Cloudinary credentials for image uploads (optional; local fallback available)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
